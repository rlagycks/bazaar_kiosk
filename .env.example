# 설정 예시입니다. Django는 이 파일을 자동으로 불러오지 않습니다.
# **실제 비밀값을 이 파일에 넣지 마세요.** 커밋되는 파일입니다.
#
# 표시 규칙
#   [필수]   운영(DEBUG=0)에서 없으면 시작을 거부합니다.
#   [생성]   직접 정할 필요 없이 아래 명령으로 만들어 채우면 됩니다.
#   [입력]   운영 환경에 맞는 값을 사람이 정해야 합니다.
#   [선택]   없어도 시작합니다.
#
# [생성] 항목 만들기
#   SECRET_KEY:  .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
#   JWT 서명 키: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
# 만든 값은 이 파일이 아니라 운영 환경의 비밀 저장소에 넣습니다.

# ---------------------------------------------------------------------------
# 실행 모드
# ---------------------------------------------------------------------------
# [필수] 기본값이 없습니다. 0 또는 1을 반드시 적어야 시작합니다.
# 기본값을 두면 아무것도 설정하지 않은 배포가 개발 설정 그대로 뜨고,
# 아래의 운영 필수 검사에 아예 닿지 않습니다.
DEBUG=1

# ---------------------------------------------------------------------------
# 운영(DEBUG=0) 필수
# ---------------------------------------------------------------------------
# [필수][생성] 아래 예시 문자열 그대로는 운영에서 거부됩니다.
SECRET_KEY=replace-with-a-long-random-development-secret

# [필수][입력] 운영에서 비어 있으면 거부됩니다. DEBUG=1에서는 '*'가 적용됩니다.
ALLOWED_HOSTS=localhost,127.0.0.1

# [필수][입력] 운영에서 비어 있으면 거부됩니다. https 스킴까지 포함합니다.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# [필수][입력] 공용 계정 JSON. ORDER/B1_COUNTER/KITCHEN만 허용합니다.
# 예: {"ORDER":{"id":"order","password_hash":"<PBKDF2 인코딩 값>"}}
# 실제 비밀번호·해시는 이 파일이 아니라 비밀 저장소에 둡니다. PIN 로그인은 제거됐습니다.
# 해시 생성은 docs/modernization/JWT_AUTHENTICATION.md를 따릅니다.
ROLE_ACCOUNTS={}

# ---------------------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------------------
# [필수][입력] 누락되거나 PostgreSQL이 아니면 모드와 무관하게 시작 오류입니다.
# 아래는 compose.dev.yaml의 loopback 개발 DB입니다.
# sslmode=disable은 로컬 개발 전용이며 운영 연결의 기본은 require입니다.
DATABASE_URL=postgresql://bazaar_dev:synthetic-local-dev-only@127.0.0.1:55436/bazaar_dev?sslmode=disable

# ---------------------------------------------------------------------------
# JWT 인증
# ---------------------------------------------------------------------------
# [필수][생성] SECRET_KEY와 다른 50자 이상의 무작위 서명 키.
JWT_SIGNING_KEY=
# [선택][입력] 역방향 프록시를 앞에 두는 경우에만, 그 프록시 주소(또는 CIDR)를 콤마로 적습니다.
# 이 주소에서 온 요청에 한해 X-Forwarded-For의 클라이언트 주소를 신뢰합니다.
# 비워 두면 접속 peer 주소를 그대로 씁니다(프록시 없는 배포의 올바른 값).
# 잘못 넓게 적으면 누구나 자기 주소를 지정해 로그인 실패 제한을 피할 수 있습니다.
TRUSTED_PROXY_IPS=

# 고정된 계약: 액세스15분, 로그인 기준 리프레시12시간, 쿠키 HttpOnly/Secure/Strict.
# 로그인 실패 제한: 계정 ID + 직접 접속 IP별 5분 내 10회 실패 시 5분 잠금(D-045).
# 수명·SameSite·실패 제한은 환경 변수가 아니라 코드에 고정됐습니다.
# 개발 브라우저도 HTTPS 사용. 테스트 프로필만 쿠키 Secure를 끕니다.

# ---------------------------------------------------------------------------
# 선택
# ---------------------------------------------------------------------------
# [선택] 실시간 연동입니다. RLS가 검증된 공개 익명 키만 사용합니다.
# 익명 키는 Row Level Security의 대체물이 아닙니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
