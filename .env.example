# Development example only. Django does not load this file automatically.
# Never put production credentials or real operational PINs in a committed file.

# With the current legacy settings, DEBUG=1 also makes ALLOWED_HOSTS=['*'].
# This file is for a loopback development server, never a deployment baseline.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Leave empty for local SQLite. Use an encoded PostgreSQL URL when required.
DATABASE_URL=

# Optional realtime integration. Use only a public anonymous key with verified RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local demonstration values only. Replace the current PIN-based design before
# treating it as an internet-facing authentication boundary.
ROLE_PINS=ORDER:1001,B1_COUNTER:2001,KITCHEN:3001,KITCHEN_HALL:4001,KITCHEN_TAKEOUT:5001
