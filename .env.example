# 개발 환경 예시로만 사용합니다. Django는 이 파일을 자동으로 불러오지 않습니다.
# 커밋되는 파일에 운영 자격 증명이나 실제 운영 PIN을 절대 넣지 마세요.

# 현재 레거시 설정에서는 DEBUG=1로 인해 ALLOWED_HOSTS=['*']도 적용됩니다.
# 이 파일은 루프백 개발 서버용이며, 배포 기준으로 사용해서는 안 됩니다.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 로컬 SQLite를 사용하려면 비워 둡니다. 필요한 경우 인코딩된 PostgreSQL URL을 사용합니다.
DATABASE_URL=

# 선택 사항인 실시간 연동입니다. RLS가 검증된 공개 익명 키만 사용합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 로컬 시연용 값입니다. 인터넷에 노출되는 인증 경계로 사용하기 전에 현재 PIN 기반
# 설계를 교체하세요.
ROLE_PINS=ORDER:1001,B1_COUNTER:2001,KITCHEN:3001,KITCHEN_HALL:4001,KITCHEN_TAKEOUT:5001
