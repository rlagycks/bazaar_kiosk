# 12A1 -- the deployment host's `.env`, read by docker compose and by
# scripts/deploy/*. Copy to `.env` on the host and fill in; `.env` is
# gitignored. **No secrets go here**: those are files under ./secrets/
# (scripts/deploy/make_secrets.sh). Hostnames and origins are configuration.

# [입력] 공개 도메인. 인증서·nginx server_name·ALLOWED_HOSTS가 모두 이 값을 쓴다.
BK_DOMAIN=kiosk.example.org

# [입력] Django ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS (compose.prod.yaml이 앱에 넘긴다).
# 보통 BK_DOMAIN 하나면 된다. 콤마로 여러 개.
BK_ALLOWED_HOSTS=kiosk.example.org
BK_CSRF_TRUSTED_ORIGINS=https://kiosk.example.org

# [선택] HSTS max-age(초). 처음에는 300으로 두고, https가 며칠 문제없이 돌아간 뒤
# 31536000으로 올린다. 값을 바꾸면 render_nginx.sh 뒤 proxy reload.
BK_HSTS_MAX_AGE=300

# [선택] certbot webroot(호스트 경로). server_setup.sh가 만드는 기본값과 같다.
BK_CERTBOT_WEBROOT=/var/lib/bazaar_kiosk/certbot-www

# [고정] 프록시 컨테이너의 내부 주소. compose.prod.yaml이 이 값을 고정 할당하고
# 앱은 이 주소에서 온 X-Forwarded-For만 믿는다(이슈 #61). 바꾸지 않는다.
BK_PROXY_INTERNAL_IP=10.89.0.10

# [고정] 합성 스트림 계측기. 운영에서는 0.
BK_STREAM_PROBE=0
