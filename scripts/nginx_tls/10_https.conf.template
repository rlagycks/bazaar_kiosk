# 12A1 -- port 443. Rendered by scripts/deploy/render_nginx.sh; only
# ${BK_DOMAIN} and ${BK_HSTS_MAX_AGE} are substituted, every other "$" is
# nginx's own. The locations mirror scripts/nginx_prod.conf (the plain-HTTP
# candidate this file replaces on a real host); the differences are TLS, the
# HSTS header, and request limits on the two login pages.
#
# HSTS: BK_HSTS_MAX_AGE starts small (see .env.prod.example). Raise it only
# after the domain has served https for a while without a wrong-certificate
# incident; a large value is not something a browser forgets when you need it to.
#
# limit_req: Django already blocks 10 failures per account+IP in 5 minutes
# (D-045). These zones are the layer in front of that -- they stop one address
# from hammering the login *page* or the admin site, which Django's own admin
# does not throttle. The rates are per client address; at a venue where many
# phones share one NAT address, that address is the whole event, so the login
# zone is deliberately generous and the admin zone is the tight one.

limit_req_zone $binary_remote_addr zone=bk_login:1m rate=60r/m;
limit_req_zone $binary_remote_addr zone=bk_admin:1m rate=20r/m;
limit_req_status 429;

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${BK_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${BK_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BK_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:bk_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    root /usr/share/nginx/html;

    # Django sets nosniff / X-Frame-Options DENY / Referrer-Policy / COOP on its
    # own responses (SecurityMiddleware defaults); the static locations include
    # the same set from the image. HSTS is a transport property, so it is added
    # here, in every location, because nginx's add_header does not inherit
    # into a location that has add_header lines of its own.

    location = /static/staticfiles.json {
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        return 404;
    }

    location ~ "^/static/.+\.[0-9a-f]{12}\.[^./]+(\.gz)?$" {
        include /etc/nginx/bk_static_headers.conf;
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        gzip_static on;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /static/ {
        include /etc/nginx/bk_static_headers.conf;
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        gzip_static on;
        add_header Cache-Control "public, max-age=60";
    }

    location /orders/api/stream/ {
        include /etc/nginx/bk_proxy_headers.conf;
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location = /orders/login/ {
        limit_req zone=bk_login burst=60 nodelay;
        include /etc/nginx/bk_proxy_headers.conf;
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    location /admin/ {
        limit_req zone=bk_admin burst=20 nodelay;
        include /etc/nginx/bk_proxy_headers.conf;
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    location / {
        include /etc/nginx/bk_proxy_headers.conf;
        add_header Strict-Transport-Security "max-age=${BK_HSTS_MAX_AGE}" always;
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}
